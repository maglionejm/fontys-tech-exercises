# Virtual environments (one .venv at the repository root; never commit any)
.venv/
.venv*/
venv/
env/

# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store

# Local outputs generated while running the notebooks
*.joblib
outputs/

# Microsoft Office lock files
~$*

# Local scratch from coding agents and one-off experiments
.codex-*/
.claude/
# ... except the Module 5 lab project, which ships its Claude Code configuration on purpose
!M5 - Harness Engineering/lab/.claude/
**/.claude/settings.local.json
M5 - Harness Engineering/lab/**/*.log

# Local site preview and Python build artifacts
docs/.cache/
*.egg-info/
build/
dist/

# Local credentials: never commit. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Gradio cache written next to the M2 deployment notebook
.gradio/
