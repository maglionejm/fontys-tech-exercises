# Copy this file to .env (same folder) and fill in your key. .env is git-ignored.
# Module 5 notebooks read it automatically and run on real Claude models when it is set;
# without it they fall back to the deterministic ScriptedModel stand-in.
ANTHROPIC_API_KEY=

