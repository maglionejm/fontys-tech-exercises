# Copy this file to .env (same folder) and fill in your key. .env is git-ignored and is never
# read by anything except the Module 5 setup cells and the harness package's load_client().
# Module 5 (Harness Engineering) runs on real Claude models and needs this key to run at all.
# In GitHub Actions the same variable comes from the ANTHROPIC_API_KEY repository secret.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# HARNESS_MODEL=claude-opus-5          # lead / main agents
# HARNESS_WORKER_MODEL=claude-sonnet-5 # sub-agents, judges, routers, planners
